+    (OUT / "SENARYO_KARSILASTIRMA.md").write_text(_karsilastirma(), encoding="utf-8")
+    print(f"Wrote SENARYO_RAPOR_{{A,B,C}}.md + SENARYO_KARSILASTIRMA.md")
+
