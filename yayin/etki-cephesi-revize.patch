+        assert abs(c["v_ici_dagitilmayan"] + c["tr_bosalma_disi_kayip"] + c["havza_alicisiz_zarar"] + c["havza_alicisi_belli_rant_cikisi"] + c["havza_dis_baglama_belirsiz"] - s["olu_agirlik"]) < 6e-3
+        # aralıklar: alt ≤ üst, kapasite sınırı aralığı daraltır ama dışına çıkarmaz
+        for k in ("gercek_yikim_pay_aralik", "olcum_boslugu_pay_aralik"):
+            assert 0 <= s[k][0] <= s[k][1] <= 1
+        a, b = s["gercek_yikim_pay_aralik"], s["gercek_yikim_pay_aralik_kapasite_sinirli"]
+        assert a[0] <= b[0] <= b[1] <= a[1] + 1e-9
+        f = s["dis_baglama_gelir_odemesi_siniri"]
+        assert 0 < f["rant_koprusu"] <= f["bop_koprusu"] <= 1.0
+        # yıkım üst + ölçüm boşluğu alt = D (belirsiz kova iki uca da tam yazılır)
+        assert abs(s["gercek_yikim_aralik"][1] + s["olcum_boslugu_aralik"][0] - s["olu_agirlik"]) < 6e-3
+        # ham kazançla D, V sınırı yokken en çok V sınırlı D kadar; ikame çift sayımı D'yi artırır
+        assert s["olu_agirlik_ham_kazanc"] <= s["olu_agirlik"] + 1e-9
