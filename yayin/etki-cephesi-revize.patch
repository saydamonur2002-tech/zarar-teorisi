+        for t in per:
+            w.writerow([t] + [d[k].get(t, "") for k in ("X", "M", "YG", "YGgelir", "PGgider")])
+    print(f"Wrote {OUT} ({len(per)} ay, {per[0]}..{per[-1]})")
+
+
+def borc_cevirme() -> None:
+    rows, _ = evds_cek.fetch_group("bie_oderoll", start="01-01-2005", end="31-12-2036", freq="5")
