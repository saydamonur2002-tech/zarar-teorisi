+        assert abs(s["kredi_toplam_aktor_arti_havza_girisi"] - (muh[sid]["kazanc"]["toplam"] + ig)) < 5e-3
+        assert abs(s["olu_agirlik"] - ob[sid]["olu_agirlik"]) < 5e-3
