+| 0.2 | 0.133 | 0.1843 | 0.2186 | -15.982 | 39.0 | dusuk_uygulanabilirlik |
+| 0.3 | 0.1995 | 0.1843 | 0.2186 | -15.677 | 40.0 | dusuk_uygulanabilirlik |
