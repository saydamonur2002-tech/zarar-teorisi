+    assert d["bugunku_P"] == {"A": 0.333, "B": 0.333, "C": 0.333}  # baz 2026: kontrol noktaları gelecekte
+    assert d["eski_el_atamasi"]["C"] == 0.6  # eski değer yalnız karşılaştırma için
